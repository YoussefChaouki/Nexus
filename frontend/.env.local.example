# Base URL of the NEXUS FastAPI backend.
# Used by both server components (fetch) and client components (EventSource).
NEXT_PUBLIC_NEXUS_API_URL=http://localhost:8000

# Optional — Langfuse host (e.g. https://cloud.langfuse.com or self-hosted).
# When set, the report viewer surfaces a deep-link to the traces page
# filtered on the run's session ID. Leave empty to hide the link.
NEXT_PUBLIC_LANGFUSE_HOST=
NEXT_PUBLIC_LANGFUSE_PROJECT_ID=
