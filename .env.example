# LLM providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# Observability
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# Infrastructure
REDIS_URL=redis://localhost:6379
POSTGRES_DSN=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus

# External APIs
NVD_API_KEY=

# Model configuration
LLM_MODEL=gpt-4o
# 0.0 = deterministic structured outputs (recommended for the pipeline)
LLM_TEMPERATURE=0.0
# OpenAI SDK retries on 429/5xx (exponential backoff, honours Retry-After)
LLM_MAX_RETRIES=5
# Concurrent per-finding LLM/embedding calls — lower this on low-TPM orgs
LLM_CONCURRENCY=4
EMBEDDING_MODEL=text-embedding-3-small
MAX_ITERATIONS=3

# Researcher relevance filtering
RESEARCHER_MIN_RELEVANCE=0.5
RESEARCHER_MIN_CONTEXT_RELEVANCE=0.35
